# ============================================================
# 多平台电商销售日报生成器 —— 忽略规则
# 原则：只提交「源码 + 文档 + 可随时重建的样例输入」，
#       一切运行产物、测试产物、本机调试痕迹、环境快照都不入库。
# ============================================================

# ---------- Python ----------
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.coverage
.coverage.*
htmlcov/

# ---------- 测试与调试产物 ----------
# JUnit XML 测试报告（pytest --junitxml 生成，路径在本机任意位置）
*.xml
# pytest basetemp / 临时工作目录
.pytest_tmp/
# 沙箱 ACL 诊断产物：含本机磁盘绝对路径与 Windows 用户 SID，绝不可外泄
.regression_probe/

# ---------- 本地运行与演示产物 ----------
# 运行时数据（规划第 3 节：data/ 运行时生成）
data/
!data/.gitkeep
# 便携版运行时数据与生成物
portable/core/data/
portable/输入表格放这里/*
!portable/输入表格放这里/.gitkeep
portable/生成的报表在里头/*
!portable/生成的报表在里头/.gitkeep
# Release 打包产物
dist/
# 演示跑批产物（含 app.db、导出的 xlsx）
.demo_run/
# 模拟生成文件（可随时重新生成）
**/samples/mock/

# ---------- 内部工具痕迹（与项目本身无关）----------
.qoder/
.qoder-tmp/
.workbuddy/

# ---------- 前端 ----------
**/node_modules/
**/frontend/dist/
**/backend/app/static/
!**/backend/app/static/.gitkeep
# Vite 依赖预构建时落下的临时配置快照
**/vite.config.js.timestamp-*

# ---------- 编辑器 / 系统 ----------
.idea/
.vscode/
Thumbs.db
.DS_Store
